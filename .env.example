# Contact Form (Formspree)
# 1. Create a free account at https://formspree.io
# 2. Create a new form and copy the form ID (e.g. xpwzabcd)
# 3. Add it here as VITE_FORMSPREE_ID=xpwzabcd
# If left empty, the contact form will use a mailto: fallback
VITE_FORMSPREE_ID=

# Site canonical URL (used for SEO metadata)
# Set this to your actual deployed domain (no trailing slash)
# Example: VITE_SITE_URL=https://ankushkumar.dev
VITE_SITE_URL=https://your-domain.com
